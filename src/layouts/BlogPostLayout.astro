---
import BaseLayout from './BaseLayout.astro';
import AuthorCommentModal from '../components/AuthorCommentModal.astro';
import DisqusComments from '../components/DisqusComments.astro';
import { formatDate, calculateReadTime, useTranslations, type Lang } from '../utils/i18n';
import { SITE_CONFIG } from '../config';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  lang: Lang;
  translationId: string;
  authorComment?: string;
  translations?: Partial<Record<Lang, string>>;
  content: string;
  slug: string;
}

const {
  title,
  description,
  date,
  category,
  lang,
  translationId,
  authorComment,
  translations,
  content,
  slug,
} = Astro.props;

const t = useTranslations(lang);
const formattedDate = formatDate(date, lang);
const readTime = calculateReadTime(content);
const fullUrl = `${SITE_CONFIG.title ? 'https://yinosanchez.github.io' : ''}/${lang}/posts/${slug}/`;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  translations={translations}
>
  <article class="content-container blog-post-article">
    <!-- Header del Post -->
    <header class="post-header">
      <div class="post-meta-top">
        <a href={`/${lang}/category/${encodeURIComponent(category)}/`} class="category-badge">
          {category}
        </a>
        <span class="meta-dot">•</span>
        <time datetime={date.toISOString()} class="post-date">
          {formattedDate}
        </time>
        <span class="meta-dot">•</span>
        <span class="read-time">{readTime} {t('site.readingTime')}</span>
      </div>

      <h1 class="post-main-title">{title}</h1>

      <p class="post-lead">{description}</p>

      <!-- Barra de acciones: Autor y Botón Comentario del autor -->
      <div class="post-actions-bar">
        <div class="post-author-info">
          <div class="author-avatar-sm">MSG</div>
          <div class="author-details">
            <span class="author-name">{SITE_CONFIG.author}</span>
            <span class="author-role">Autor</span>
          </div>
        </div>

        {authorComment && (
          <AuthorCommentModal comment={authorComment} lang={lang} />
        )}
      </div>
    </header>

    <!-- Contenido Markdown -->
    <div class="prose post-body">
      <slot />
    </div>

    <!-- Disqus Comments -->
    <DisqusComments
      postIdentifier={translationId}
      postTitle={title}
      postUrl={fullUrl}
      lang={lang}
    />
  </article>
</BaseLayout>

<style>
  .blog-post-article {
    margin-top: 1rem;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--bg-card-border);
  }

  .post-meta-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .meta-dot {
    opacity: 0.5;
  }

  .post-main-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .post-lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .post-actions-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--bg-card-border);
    border-radius: var(--radius-md);
  }

  .post-author-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar-sm {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--accent-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    color: white;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .author-role {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .post-body {
    margin-top: 2rem;
  }
</style>
